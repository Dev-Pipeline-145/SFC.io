{
  "name": "sfc-io",
  "version": "1.0.0",
  "description": "SalesforceConsultants.io website - static HTML/CSS/JS",
  "scripts": {
    "lint": "eslint script.js scripts/*.js",
    "lint:fix": "eslint --fix script.js scripts/*.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "serve": "npx http-server -p 8000"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"],
    "verbose": true
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
